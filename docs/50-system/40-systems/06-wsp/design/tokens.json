{
  "name": "UBOS design system",
  "version": "1.0",
  "decision": "DEC-081",
  "design": ["DSN-WSP-211", "DSN-WSP-212", "DSN-WSP-213", "DSN-WSP-214"],
  "reference": "mockups.html",
  "color": {
    "light": {
      "bg": "#f4f6f9", "surface": "#ffffff", "surface-2": "#f9fafc", "line": "#dde2ea", "line-strong": "#c4ccd8",
      "fg": "#16202c", "muted": "#5a6677", "faint": "#8a95a5",
      "accent": "#1d4e89", "accent-fg": "#ffffff", "accent-weak": "#e6eef8", "focus": "#2f6fd1",
      "positive": "#1c7a4b", "positive-weak": "#e3f3ea", "negative": "#b42318", "negative-weak": "#fde8e6",
      "attention": "#8a4b06", "attention-weak": "#fdf1d8"
    },
    "dark": {
      "bg": "#0e131a", "surface": "#151b24", "surface-2": "#1a212c", "line": "#29323f", "line-strong": "#394555",
      "fg": "#e5e9ef", "muted": "#9aa6b6", "faint": "#6e7a8b",
      "accent": "#7fa7de", "accent-fg": "#0e131a", "accent-weak": "#1c2a3f", "focus": "#8db6ef",
      "positive": "#5cc08b", "positive-weak": "#143425", "negative": "#f08b80", "negative-weak": "#3a1a17",
      "attention": "#f2b84b", "attention-weak": "#392a0c"
    }
  },
  "type": {
    "ui": {"family": "Inter", "fallback": ["Segoe UI", "system-ui", "-apple-system", "sans-serif"], "features": ["tnum", "cv11", "ss01"], "weights": [400, 500, 600, 700]},
    "mono": {"family": "JetBrains Mono", "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "weights": [400, 500], "use": "account codes, document numbers, identifiers, rule names"},
    "scale_px": {"caption": 11, "small": 12, "body": 13, "title": 15, "page": 17, "figure": 18},
    "label": {"transform": "uppercase", "letter_spacing_em": 0.05, "size_px": 11}
  },
  "density": {
    "compact": {"row_px": 30, "cell_x_px": 10, "default": true},
    "comfortable": {"row_px": 38, "cell_x_px": 14}
  },
  "shape": {"radius_px": 6, "frame_radius_px": 8, "pill_radius_px": 4},
  "layout": {"nav_width_px": 208, "drawer_width_px": 340, "single_column_below_px": 760, "drawer_stacks_below_px": 980},
  "states": {
    "draft": {"text": "Draft", "color": "muted", "mark": "hollow"},
    "pending": {"text": "Waiting for approval", "color": "attention"},
    "posted": {"text": "Posted", "color": "positive"},
    "reconciled": {"text": "Reconciled", "color": "accent"},
    "blocking": {"text": "Blocking", "color": "negative"},
    "reversed": {"text": "Reversed", "color": "muted", "mark": "strike"},
    "voided": {"text": "Voided", "color": "muted", "mark": "strike"}
  },
  "figures": {"locale": "en-US", "fraction_digits": 2, "negative_default": "parentheses", "negative_options": ["parentheses", "minus"], "date": "MM/DD/YYYY"},
  "temporal_banner": {"color": "attention", "shown_when": "a time, commit, branch other than main, or as-known-on date other than now is selected"}
}
