{
  "suite": "UBOS L2 escape suite (initial)",
  "version": "0.1",
  "verifies": "VER-SEC-0001",
  "profile": "strict unless stated",
  "cases": [
    {
      "id": "L2E-001",
      "category": "file",
      "title": "open a host file",
      "script": "open(\"/etc/passwd\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-002",
      "category": "file",
      "title": "read a file by a free function",
      "script": "read_file(\"/etc/passwd\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-003",
      "category": "file",
      "title": "write a file",
      "script": "write_file(\"/tmp/ubos-escape\", \"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-004",
      "category": "file",
      "title": "import a module from a file",
      "script": "import \"fs\" as fs; fs::read(\"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-005",
      "category": "file",
      "title": "namespaced std file API",
      "script": "std::fs::read(\"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-006",
      "category": "file",
      "title": "eval of a script string",
      "script": "eval(\"1 + 1\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-007",
      "category": "file",
      "title": "file access through a function pointer",
      "script": "let f = Fn(\"open\"); f.call(\"/etc/passwd\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-008",
      "category": "file",
      "title": "file access as a string method",
      "script": "\"/etc/passwd\".read()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-009",
      "category": "file",
      "title": "run another script file",
      "script": "run_file(\"other.rhai\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-010",
      "category": "file",
      "title": "load or include a script",
      "script": "load(\"lib.rhai\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-011",
      "category": "file",
      "title": "file capability on the gateway",
      "script": "sys.fs.read(\"/etc/passwd\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-012",
      "category": "file",
      "title": "file capability by gateway index",
      "script": "sys[\"files\"]",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-013",
      "category": "network",
      "title": "HTTP GET",
      "script": "http_get(\"http://169.254.169.254/latest/meta-data\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-014",
      "category": "network",
      "title": "fetch",
      "script": "fetch(\"https://example.com\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-015",
      "category": "network",
      "title": "raw socket connect",
      "script": "connect(\"10.0.0.1\", 80)",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-016",
      "category": "network",
      "title": "socket constructor",
      "script": "let s = socket(); s.send(\"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-017",
      "category": "network",
      "title": "DNS lookup",
      "script": "dns_lookup(\"example.com\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-018",
      "category": "network",
      "title": "import an HTTP module",
      "script": "import \"http\" as http; http::get(\"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-019",
      "category": "network",
      "title": "HTTP through a function pointer",
      "script": "Fn(\"http_get\").call(\"http://example.com\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-020",
      "category": "network",
      "title": "HTTP as a string method",
      "script": "\"http://example.com\".fetch()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-021",
      "category": "network",
      "title": "connector method on the gateway",
      "script": "sys.connector(\"bank\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-022",
      "category": "network",
      "title": "network capability by gateway index",
      "script": "sys[\"net\"]",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-023",
      "category": "network",
      "title": "send mail",
      "script": "send_mail(\"a@example.com\", \"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-024",
      "category": "network",
      "title": "connector field on the context",
      "script": "ctx.connector",
      "expect": {
        "error": "LOGIC.UNKNOWN_FIELD"
      }
    },
    {
      "id": "L2E-025",
      "category": "time",
      "title": "host timestamp",
      "script": "timestamp()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-026",
      "category": "time",
      "title": "host clock now()",
      "script": "now()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-027",
      "category": "time",
      "title": "sleep (language core package)",
      "script": "sleep(1)",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-028",
      "category": "time",
      "title": "elapsed time of a timestamp",
      "script": "let t = timestamp(); t.elapsed",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-029",
      "category": "time",
      "title": "clock method on the gateway",
      "script": "sys.now()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-030",
      "category": "time",
      "title": "environment variable TZ",
      "script": "env(\"TZ\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-031",
      "category": "time",
      "title": "system time",
      "script": "system_time()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-032",
      "category": "time",
      "title": "ctx.now is the fixed execution time",
      "script": "ctx.now",
      "expect": {
        "value": "2026-01-01T00:00:00.000000Z"
      }
    },
    {
      "id": "L2E-033",
      "category": "time",
      "title": "assign ctx.now",
      "script": "ctx.now = \"2030-01-01T00:00:00Z\"",
      "expect": {
        "error": "LOGIC.CONTEXT_IMMUTABLE"
      }
    },
    {
      "id": "L2E-034",
      "category": "time",
      "title": "assign ctx by index",
      "script": "ctx[\"now\"] = \"2030-01-01T00:00:00Z\"",
      "expect": {
        "error": "LOGIC.CONTEXT_IMMUTABLE"
      }
    },
    {
      "id": "L2E-035",
      "category": "time",
      "title": "replace the ctx object",
      "script": "ctx = #{ now: \"2030-01-01T00:00:00Z\" }",
      "expect": {
        "error": "LOGIC.CONTEXT_IMMUTABLE"
      }
    },
    {
      "id": "L2E-036",
      "category": "time",
      "title": "mutate ctx through a method with this",
      "script": "fn shift() { this.now = \"2030-01-01T00:00:00Z\"; } ctx.shift()",
      "expect": {
        "error": "LOGIC.CONTEXT_IMMUTABLE"
      }
    },
    {
      "id": "L2E-037",
      "category": "entropy",
      "title": "rand()",
      "script": "rand()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-038",
      "category": "entropy",
      "title": "random()",
      "script": "random()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-039",
      "category": "entropy",
      "title": "rand_int",
      "script": "rand_int(1, 6)",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-040",
      "category": "entropy",
      "title": "random method on the gateway",
      "script": "sys.random()",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-041",
      "category": "entropy",
      "title": "shuffle",
      "script": "let a = [3, 1, 2]; a.shuffle(); a",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-042",
      "category": "entropy",
      "title": "hash of a value",
      "script": "hash(\"x\")",
      "expect": {
        "error": "LOGIC.FORBIDDEN_CAPABILITY"
      }
    },
    {
      "id": "L2E-043",
      "category": "entropy",
      "title": "sys.random_bytes is journaled and replayable",
      "script": "sys.random_bytes(8)",
      "expect": {
        "journaled": 1
      }
    },
    {
      "id": "L2E-044",
      "category": "entropy",
      "title": "sys.uuid is journaled and replayable",
      "script": "[sys.uuid(), sys.uuid()]",
      "expect": {
        "journaled": 2
      }
    },
    {
      "id": "L2E-045",
      "category": "entropy",
      "title": "map iteration follows key order",
      "script": "let m = #{}; m.z = 1; m.a = 2; m.m = 3; m.keys()",
      "expect": {
        "value": [
          "a",
          "m",
          "z"
        ]
      }
    },
    {
      "id": "L2E-046",
      "category": "entropy",
      "title": "map JSON output follows key order",
      "script": "let m = #{}; m.b = 1; m.a = 2; m.to_json()",
      "expect": {
        "value": "{\"a\":2,\"b\":1}"
      }
    },
    {
      "id": "L2E-047",
      "category": "entropy",
      "title": "textual form of the gateway leaks no address",
      "script": "sys.to_string()",
      "expect": {
        "deterministic": true
      }
    },
    {
      "id": "L2E-048",
      "category": "entropy",
      "title": "random_bytes above the per-call maximum",
      "script": "sys.random_bytes(2000)",
      "expect": {
        "error": "LOGIC.TYPE_ERROR"
      }
    },
    {
      "id": "L2E-049",
      "category": "float",
      "title": "decimal literal addition is exact",
      "script": "1.5 + 2.25",
      "expect": {
        "value": "3.75"
      }
    },
    {
      "id": "L2E-050",
      "category": "float",
      "title": "0.1 + 0.2 == 0.3 (exact decimals)",
      "script": "0.1 + 0.2 == 0.3",
      "expect": {
        "value": true
      }
    },
    {
      "id": "L2E-051",
      "category": "float",
      "title": "to_float",
      "script": "to_float(1)",
      "expect": {
        "error": "LOGIC.FLOAT_TO_DECIMAL"
      }
    },
    {
      "id": "L2E-052",
      "category": "float",
