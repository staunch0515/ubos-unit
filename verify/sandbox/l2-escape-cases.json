        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-088",
      "category": "resource-exhaustion",
      "title": "map growth",
      "script": "let m = #{}; let i = 0; loop { m[i.to_string()] = i; i += 1; }",
      "expect": {
        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-089",
      "category": "resource-exhaustion",
      "title": "array pad to 10^8",
      "script": "let a = []; a.pad(100000000, 0); a.len()",
