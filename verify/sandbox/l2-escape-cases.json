        "error": "LOGIC.TYPE_ERROR"
      }
    },
    {
      "id": "L2E-067",
      "category": "host-abuse",
      "title": "return the object handle",
      "script": "rec",
      "expect": {
        "error": "LOGIC.TYPE_ERROR"
      }
    },
    {
      "id": "L2E-068",
      "category": "host-abuse",
