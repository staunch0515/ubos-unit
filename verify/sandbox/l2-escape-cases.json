      }
    },
    {
      "id": "L2E-084",
      "category": "resource-exhaustion",
      "title": "memory across 1,000 arrays of 65,536 elements",
      "script": "{{N:1000:let v$i = []; v$i.pad(65536, 0);\n}}1",
      "expect": {
        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-085",
      "category": "resource-exhaustion",
      "title": "unbounded recursion",
      "script": "fn f(n) { f(n + 1) } f(0)",
      "expect": {
        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-086",
      "category": "resource-exhaustion",
      "title": "string doubling",
      "script": "let s = \"x\"; loop { s += s; }",
