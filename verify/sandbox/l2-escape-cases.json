        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-090",
      "category": "resource-exhaustion",
      "title": "string pad to 10^8",
      "script": "let s = \"x\"; s.pad(100000000, \"y\"); s.len()",
      "expect": {
        "error": "LOGIC.LIMIT_EXCEEDED"
      }
    },
    {
      "id": "L2E-091",
