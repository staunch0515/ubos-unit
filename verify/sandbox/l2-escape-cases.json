      "id": "L2E-058",
      "category": "float",
      "title": "f32_to_f64",
      "script": "f32_to_f64(1)",
      "expect": {
        "error": "LOGIC.FLOAT_TO_DECIMAL"
      }
    },
    {
      "id": "L2E-059",
      "category": "float",
      "title": "decimal division is exact to 28 digits",
      "script": "1.0 / 3.0",
      "expect": {
        "value": "0.3333333333333333333333333333"
      }
    },
    {
      "id": "L2E-060",
      "category": "float",
      "title": "integer division by zero",
      "script": "1 / 0",
      "expect": {
        "error": "LOGIC.DIVISION_BY_ZERO"
      }
    },
    {
      "id": "L2E-061",
      "category": "float",
      "title": "decimal division by zero",
