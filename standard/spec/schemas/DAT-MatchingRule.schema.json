{
  "$id": "DAT-MatchingRule",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "description": "[left amount field, right amount field]",
      "type": "array"
    },
    "equal": {
      "description": "[left field, right field] pairs that must be equal",
      "type": "array"
    },
    "id": {
      "description": "rule name, unique in the list",
      "type": "string"
    },
    "kind": {
      "description": "one_to_one | one_to_many | many_to_one",
      "enum": [
        "one_to_one",
        "one_to_many",
        "many_to_one"
      ],
      "type": "string"
    },
    "negate": {
      "description": "compare the left amount with the negated right amount",
      "type": "boolean"
    },
    "tolerance": {
      "description": "largest absolute difference per currency; default 0",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "window_days": {
      "description": "largest distance of the valid_at dates in days; default 0",
      "type": [
        "integer",
        "string"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "amount"
  ],
  "title": "DAT-MatchingRule",
  "type": "object"
}
