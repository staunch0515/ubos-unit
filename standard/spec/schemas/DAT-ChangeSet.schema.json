      "type": "array"
    },
    "simulations": {
      "description": "simulation run URIs",
      "type": "array"
    },
    "source": {
      "description": "branch name",
      "type": "string"
    },
    "target": {
      "description": "branch name",
      "type": "string"
    },
    "title": {
      "description": "short title",
      "type": "string"
    }
  },
  "required": [
    "source",
    "target",
    "title"
  ],
  "title": "DAT-ChangeSet",
  "type": "object"
