{
  "$id": "DAT-MeteringRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset": {
      "description": "logic asset version hash",
      "type": "string"
    },
    "connector_calls": {
      "description": "count",
      "type": [
        "integer",
        "string"
      ]
    },
    "cpu_us": {
      "description": "CPU microseconds",
      "type": [
        "integer",
        "string"
      ]
    },
    "instructions": {
      "description": "count per family",
      "type": "object"
    },
    "model_usage": {
      "description": "{calls, input_tokens, output_tokens, cost}",
      "type": "object"
    },
    "outcome": {
      "description": "ok | error | limit | cancelled",
      "enum": [
        "ok",
        "error",
        "limit",
        "cancelled"
      ],
      "type": "string"
    },
    "peak_memory": {
      "description": "bytes",
      "type": [
        "integer",
        "string"
      ]
    },
    "process_id": {
      "description": "process",
      "type": "string"
    },
    "units": {
      "description": "operation units consumed",
      "type": [
        "integer",
        "string"
      ]
    },
    "wall_us": {
      "description": "wall microseconds",
      "type": [
        "integer",
        "string"
      ]
    }
  },
  "required": [
    "process_id",
    "units",
    "cpu_us",
    "peak_memory",
    "wall_us",
    "instructions",
    "connector_calls",
    "outcome"
  ],
  "title": "DAT-MeteringRecord",
  "type": "object"
}
