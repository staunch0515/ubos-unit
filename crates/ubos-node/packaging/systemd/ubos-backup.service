[Unit]
Description=UBOS base backup (DSN-NOD-620)
After=postgresql.service

[Service]
Type=oneshot
User=ubos
Group=ubos
ExecStart=/usr/local/bin/ubos-server backup base --config /etc/ubos/ubos.toml
EnvironmentFile=-/etc/ubos/ubos.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/ubos
