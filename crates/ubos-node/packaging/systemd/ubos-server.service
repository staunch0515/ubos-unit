[Unit]
Description=UBOS Server (single node)
Documentation=file:///usr/local/share/doc/ubos-server/INSTALL.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubos
Group=ubos
ExecStart=/usr/local/bin/ubos-server --config /etc/ubos/ubos.toml
# SIGHUP reloads the reloadable keys of ubos.toml (DSN-NOD-604)
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/etc/ubos/ubos.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/ubos /var/lib/ubos
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
