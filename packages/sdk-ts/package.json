{
  "name": "@ubos/sdk",
  "version": "0.2.0",
  "description": "The TypeScript SDK of UBOS for browsers and Node.js: transport, session, operations, files and exact decimals over UBTP (DSN-SDK-001…017; PH-1 step 17c, DEC-078)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "lint": "eslint .",
    "size": "node tools/size.mjs",
    "examples": "tsc -p tsconfig.examples.json && esbuild examples/browser.ts --bundle --format=esm --outfile=build/examples/browser.js",
    "check": "npm run typecheck && npm run lint && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
