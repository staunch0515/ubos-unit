{
  "name": "@ubos/eng-ui",
  "version": "0.1.0",
  "description": "The engineering UI prototype of UBOS used for the acceptance of PH-1b: generated forms, lists, details and history over the TypeScript SDK only (PH-1 step 17f, DEC-078)",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --alias:@ubos/sdk=../sdk-ts/src/index.ts --outfile=dist/app.js && cp index.html dist/index.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "serve": "node tools/serve.mjs",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@ubos/sdk": "file:../sdk-ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
